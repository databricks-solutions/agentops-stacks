# PR checks for {{ .input_project_name }} — unit tests, bundle validation, conditional eval gate.
name: PR checks for {{ .input_project_name }}

on:
  pull_request:
  workflow_dispatch:

defaults:
  run:
    working-directory: .

env:
  {{ if (eq .input_cloud `azure`) -}}
  ARM_TENANT_ID: {{`${{ secrets.STAGING_AZURE_SP_TENANT_ID }}`}}
  ARM_CLIENT_ID: {{`${{ secrets.STAGING_AZURE_SP_APPLICATION_ID }}`}}
  ARM_CLIENT_SECRET: {{`${{ secrets.STAGING_AZURE_SP_CLIENT_SECRET }}`}}
  {{- else -}}
  DATABRICKS_TOKEN: {{`${{ secrets.STAGING_WORKSPACE_TOKEN }}`}}
  {{- end }}

jobs:
  unit_tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true
      - run: uv sync
        working-directory: src/agents/{{ .input_initial_agent_name }}
      # Exit 5 from pytest means "no tests collected" — pass until the project adds tests.
      - run: uv run pytest ../../../tests/ || [ $? -eq 5 ]
        working-directory: src/agents/{{ .input_initial_agent_name }}

  validate_bundle:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: databricks/setup-cli@{{template `cli_version` .}}
      - name: Validate bundle for staging
        run: databricks bundle validate -t staging

  # Detect which production patterns are present in the project. hashFiles()
  # isn't usable in job-level `if:` (it only works on a runner after checkout),
  # so we do the check in a small dedicated job whose outputs gate the rest.
  detect_patterns:
    runs-on: ubuntu-latest
    outputs:
      has_eval: {{`${{ steps.check.outputs.has_eval }}`}}
    steps:
      - uses: actions/checkout@v4
      - id: check
        run: |
          if find src/agents -name "gates.yml" -path "*/eval/gates.yml" 2>/dev/null | grep -q .; then
            echo "has_eval=true" >> "$GITHUB_OUTPUT"
          else
            echo "has_eval=false" >> "$GITHUB_OUTPUT"
          fi

  eval_gate:
    needs: [validate_bundle, detect_patterns]
    if: {{`${{ needs.detect_patterns.outputs.has_eval == 'true' }}`}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true
      - name: Run eval gate for each agent
        # evaluate_agent.py loads eval/gates.yml, runs mlflow.genai.evaluate against
        # the UC eval table, compares challenger vs champion, and exits non-zero on failure.
        # Falls back to an inline dataset when CATALOG/SCHEMA are unset.
        run: |
          for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
            agent_dir=$(dirname "$(dirname "$gates_file")")
            echo "Running eval gate for $agent_dir"
            (cd "$agent_dir" && uv sync && uv run python eval/evaluate_agent.py)
          done
