# Staging deploy for {{ .input_project_name }} — validates, deploys, runs post-deploy eval gate if applied.
name: Staging deploy for {{ .input_project_name }}

on:
  push:
    branches:
      - 'main'
  workflow_dispatch:

defaults:
  run:
    working-directory: .

env:
  {{ if (eq .input_cloud `azure`) -}}
  ARM_TENANT_ID: {{`${{ secrets.STAGING_AZURE_SP_TENANT_ID }}`}}
  ARM_CLIENT_ID: {{`${{ secrets.STAGING_AZURE_SP_APPLICATION_ID }}`}}
  ARM_CLIENT_SECRET: {{`${{ secrets.STAGING_AZURE_SP_CLIENT_SECRET }}`}}
  {{- else -}}
  DATABRICKS_CLIENT_ID: {{`${{ secrets.STAGING_SP_CLIENT_ID }}`}}
  DATABRICKS_CLIENT_SECRET: {{`${{ secrets.STAGING_SP_CLIENT_SECRET }}`}}
  {{- end }}
  # Run exactly what uv.lock pins: `uv run` must not re-resolve and rewrite the lock.
  UV_FROZEN: "1"

jobs:
  deploy:
    concurrency: {{ .input_project_name }}-staging-bundle-job
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: databricks/setup-cli@{{template `cli_version` .}} # {{template `cli_version_tag` .}}
      - name: Validate bundle for staging
        run: databricks bundle validate -t staging
      - name: Deploy bundle to staging
        run: databricks bundle deploy -t staging
      - name: Start the agent Apps on the new code
        run: |
          # `bundle deploy` doesn't ship code to the Apps or start them; `bundle run` does, for every App.
          for app in $(databricks bundle summary -t staging -o json | python3 -c 'import json, sys; print(" ".join(json.load(sys.stdin).get("resources", {}).get("apps", {})))'); do
            databricks bundle run "$app" -t staging
          done

  # See detect_patterns rationale in the PR-check workflow.
  detect_patterns:
    runs-on: ubuntu-latest
    outputs:
      has_eval: {{`${{ steps.check.outputs.has_eval }}`}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: check
        run: |
          if find src/agents -name "gates.yml" -path "*/eval/gates.yml" 2>/dev/null | grep -q .; then
            echo "has_eval=true" >> "$GITHUB_OUTPUT"
          else
            echo "has_eval=false" >> "$GITHUB_OUTPUT"
          fi

  eval_gate:
    needs: [deploy, detect_patterns]
    if: {{`${{ needs.detect_patterns.outputs.has_eval == 'true' }}`}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: databricks/setup-cli@{{template `cli_version` .}} # {{template `cli_version_tag` .}}
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: true
      - name: Run eval gate for each agent (post-deploy)
        # evaluate_agent.py scores the target's UC eval table with Databricks-hosted
        # judges and exits non-zero when a gate fails or nothing could be scored.
        # Host, catalog, schema and experiment come from the bundle, so they always
        # match the target (including the experiment, once the target is deployed).
        run: |
          summary=$(databricks bundle summary -t staging -o json)
          export DATABRICKS_HOST=$(jq -r '.workspace.host' <<<"$summary")
          export CATALOG=$(jq -r '.resources.schemas.project_schema.catalog_name' <<<"$summary")
          export SCHEMA=$(jq -r '.resources.schemas.project_schema.name' <<<"$summary")
          export MLFLOW_TRACKING_URI=databricks
          experiment_id=$(jq -r '.resources.experiments.experiment.id // empty' <<<"$summary")
          if [ -n "$experiment_id" ]; then export MLFLOW_EXPERIMENT_ID="$experiment_id"; fi
          for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
            agent_dir=$(dirname "$(dirname "$gates_file")")
            echo "Running eval gate for $agent_dir"
            (cd "$agent_dir" && uv sync --frozen && uv run python eval/evaluate_agent.py)
          done
