"""Genie Space tool — query structured data via a Databricks Genie Space.

Shared component — any agent can import and use this tool.
"""

from langchain_core.tools import tool
from databricks.sdk import WorkspaceClient

{{ if (ne .input_genie_space_id "") }}
GENIE_SPACE_ID = "{{ .input_genie_space_id }}"
{{ else }}
# TODO: Set your Genie Space ID
GENIE_SPACE_ID = ""
{{ end }}


@tool
def query_genie(question: str) -> str:
    """Query structured data using a Databricks Genie Space.

    Use this tool when the user asks about structured data, metrics,
    dashboards, or anything that requires querying tables.

    Args:
        question: A natural language question about the data.

    Returns:
        The Genie Space response with query results.
    """
    if not GENIE_SPACE_ID:
        return "Error: GENIE_SPACE_ID is not configured. Set it in src/components/tools/genie_tool.py."

    w = WorkspaceClient()

    conversation = w.genie.start_conversation(
        space_id=GENIE_SPACE_ID,
        content=question,
    )

    result = w.genie.get_message_query_result(
        space_id=GENIE_SPACE_ID,
        conversation_id=conversation.conversation_id,
        message_id=conversation.message_id,
    )

    if result.columns and result.data:
        header = " | ".join(col.name for col in result.columns)
        rows = [" | ".join(str(v) for v in row) for row in result.data]
        return f"{header}\n" + "\n".join(rows)

    return "No results returned from Genie Space."
