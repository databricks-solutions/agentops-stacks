"""Vector Search retriever — query a Databricks VS index and return chunks."""

import os

from databricks_langchain import DatabricksVectorSearch

CATALOG = os.environ["CATALOG"]
SCHEMA = os.environ["SCHEMA"]
VS_INDEX_NAME = f"{CATALOG}.{SCHEMA}.{{ .input_project_name }}_vs_index"
COLUMNS = ["content", "doc_uri"]


def get_retriever(k: int = 5):
    """Return a LangChain-compatible retriever backed by Databricks Vector Search."""
    return DatabricksVectorSearch(
        index_name=VS_INDEX_NAME,
        columns=COLUMNS,
    ).as_retriever(search_kwargs={"k": k})


def get_relevant_chunks(query: str, k: int = 5) -> list[str]:
    """Query the VS index and return chunk texts."""
    retriever = get_retriever(k=k)
    docs = retriever.invoke(query)
    return [doc.page_content for doc in docs]
