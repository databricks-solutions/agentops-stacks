[project]
name = "{{ .input_project_name }}"
version = "0.1.0"
description = "{{ .input_project_name }} — AgentOps Stacks project"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.129.0",
    "uvicorn>=0.41.0",
    "mlflow>=3.10.0",
    "databricks-sdk",
    "databricks-langchain>=0.17.0",
    "databricks-vectorsearch<0.74",
    "databricks-agents>=1.9.3",
    "langgraph>=1.1.0",
    "python-dotenv>=1.2.1",
{{ if (eq .input_use_vector_search "yes") }}    "databricks-vectorsearch",
{{ end }}
{{ if (eq .input_use_lakebase "yes") }}    "langgraph-checkpoint-postgres",
    "psycopg[binary]",
{{ end }}
]

[tool.uv]
prerelease = "allow"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.6",
    "databricks-connect",
    "nest-asyncio",
]
