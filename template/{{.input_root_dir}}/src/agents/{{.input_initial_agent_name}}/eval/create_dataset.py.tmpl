# MAGIC %md
# MAGIC ## Build dataset from production traces
# MAGIC
# MAGIC Filters production traces by tag to build an evaluation dataset.
# MAGIC Tag traces in production with `eval_candidate=true` to include them.

# COMMAND ----------

import mlflow
import pandas as pd

# Search for traces tagged as eval candidates
experiment_name = "/Shared/{{ .input_project_name }}_{{ .input_initial_agent_name }}_eval"
mlflow.set_experiment(experiment_name)
experiment = mlflow.get_experiment_by_name(experiment_name)

traces = mlflow.search_traces(
    experiment_ids=[experiment.experiment_id],
    filter_string="tags.eval_candidate = 'true'",
    max_results=500,
)

if len(traces) == 0:
    print("No traces tagged with eval_candidate=true found.")
    print("Tag production traces first:")
    print("  client.set_tag(trace_id, 'eval_candidate', 'true')")
    dbutils.notebook.exit("No eval candidate traces found")

# Convert traces to eval dataset format
eval_rows = []
for _, trace in traces.iterrows():
    eval_rows.append({
        "inputs": trace.get("request"),
        "ground_truth": trace.get("response"),
        "category": trace.get("tags.category", "core"),
    })

eval_df = pd.DataFrame(eval_rows)
print(f"Built {len(eval_df)} examples from production traces")

