# MAGIC %md
# MAGIC ## Generate synthetic dataset from source documents
# MAGIC
# MAGIC Uses `databricks.agents.evals.generate_evals_df` to synthesize evaluation
# MAGIC questions from your source documents. The generator creates realistic
# MAGIC questions with expected facts and retrieval context.
# MAGIC
# MAGIC Docs: https://docs.databricks.com/aws/en/generative-ai/agent-evaluation/synthesize-evaluation-set

# COMMAND ----------

import pandas as pd
from databricks.agents.evals import generate_evals_df, estimate_synthetic_num_evals

# TODO: Load your source documents. Each row needs 'content' and 'doc_uri' columns.
# Option A: From a Delta table
# docs = spark.table(f"{catalog}.{schema}.source_documents").toPandas()

# Option B: Inline examples (replace with your actual documents)
docs = pd.DataFrame([
    {
        "content": "Databricks is a unified analytics platform for data engineering, "
                   "data science, and machine learning. It provides collaborative "
                   "notebooks, automated cluster management, and integration with "
                   "popular data tools.",
        "doc_uri": "https://docs.databricks.com/introduction",
    },
    {
        "content": "Unity Catalog provides centralized governance for all data and AI "
                   "assets across Databricks workspaces. It offers fine-grained access "
                   "control, data lineage, and auditing capabilities.",
        "doc_uri": "https://docs.databricks.com/unity-catalog",
    },
])

# Estimate how many evals to generate for good coverage
num_evals = estimate_synthetic_num_evals(docs)
print(f"Estimated evals for full coverage: {num_evals}")

# Generate synthetic evaluation dataset
eval_df = generate_evals_df(
    docs,
    num_evals=num_evals,
    agent_description="An AI assistant that answers questions about {{ .input_project_name }}.",
    question_guidelines="Generate questions a user would realistically ask. "
                        "Include both simple factual questions and more complex "
                        "multi-hop reasoning questions.",
)

print(f"Generated {len(eval_df)} synthetic examples")
eval_df.head()

