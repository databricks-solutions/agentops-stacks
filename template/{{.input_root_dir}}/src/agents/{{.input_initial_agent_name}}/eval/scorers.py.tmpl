# COMMAND ----------

import mlflow
from mlflow.genai.scorers import (
    Fluency,
    RelevanceToQuery,
    Safety,
    ToolCallCorrectness,
    Completeness,
    scorer,
    get_scorer,
    ScorerSamplingConfig,
)
from mlflow.entities import Feedback

# COMMAND ----------

# MAGIC %md
# MAGIC ## Set experiment

# COMMAND ----------

import os

PROJECT_NAME = "{{ .input_project_name }}"
AGENT_NAME = "{{ .input_initial_agent_name }}"
EXPERIMENT_NAME = f"/Shared/{PROJECT_NAME}_{AGENT_NAME}_eval"

mlflow.set_experiment(EXPERIMENT_NAME)
print(f"Experiment: {EXPERIMENT_NAME}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## Register built-in scorers
# MAGIC
# MAGIC Only the scorers relevant to this agent's components are registered.

# COMMAND ----------

builtin_scorers = {
    "safety": Safety(),
    "fluency": Fluency(),
{{ if (eq .input_use_vector_search "yes") }}    "relevance": RelevanceToQuery(),
    "groundedness": Completeness(),
{{ end }}{{ if (eq .input_use_uc_functions "yes") }}    "tool_call_correctness": ToolCallCorrectness(),
{{ end }}}

for name, s in builtin_scorers.items():
    registered = s.register(name=name)
    print(f"  Registered: {registered.name}")

