"""{{ .input_initial_agent_name }} — LangGraph graph assembly.

Composes shared components into a compiled graph.
Edit tools.py to control tool selection.
"""

import os

from langgraph.graph import START, END, StateGraph, MessagesState
from langgraph.prebuilt import ToolNode
from databricks_langchain import ChatDatabricks
from tools import get_tools

LLM_ENDPOINT = os.environ.get("LLM_ENDPOINT", "databricks-claude-sonnet-4")


# --- Nodes ---

def agent_node(state: MessagesState) -> dict:
    """Call the LLM with tools bound."""
    tools = get_tools()
    llm = ChatDatabricks(endpoint=LLM_ENDPOINT)
    if tools:
        llm = llm.bind_tools(tools)
    response = llm.invoke(state["messages"])
    return {"messages": [response]}


def should_continue(state: MessagesState) -> str:
    """Route to tool_node if the last message has tool calls, otherwise end."""
    last_message = state["messages"][-1]
    if hasattr(last_message, "tool_calls") and last_message.tool_calls:
        return "tool_node"
    return END

{{ if (eq .input_use_lakebase "yes") }}
# --- Lakebase checkpointer ---

def get_checkpointer():
    """Create a PostgresSaver checkpointer using Lakebase credentials."""
    import logging
    logger = logging.getLogger(__name__)

    lakebase_instance = os.environ.get("LAKEBASE_INSTANCE")
    if not lakebase_instance:
        return None

    try:
        from databricks.sdk import WorkspaceClient
        from langgraph.checkpoint.postgres import PostgresSaver
        from psycopg import Connection

        w = WorkspaceClient()
        cred = w.database.generate_database_credential(instance_names=[lakebase_instance])
        # Use the current identity (SP client_id or user) as the Postgres username
        user = w.current_user.me().user_name
        lakebase_host = os.environ["LAKEBASE_HOST"]
        db_name = os.environ.get("LAKEBASE_DB", "default")
        conn_str = f"postgresql://{user}:{cred.token}@{lakebase_host}:5432/{db_name}?sslmode=require"
        conn = Connection.connect(conn_str, autocommit=True, prepare_threshold=0)
        checkpointer = PostgresSaver(conn)
        checkpointer.setup()
        logger.info(f"Lakebase checkpointer connected to {lakebase_instance}")
        return checkpointer
    except Exception as e:
        logger.warning(f"Failed to connect to Lakebase ({lakebase_instance}): {e}. Running without memory.")
        return None
{{ end }}

# --- Graph ---

def build_graph():
    tools = get_tools()
    builder = StateGraph(MessagesState)

    builder.add_node("agent", agent_node)
    if tools:
        builder.add_node("tool_node", ToolNode(tools))

    builder.add_edge(START, "agent")

    if tools:
        builder.add_conditional_edges("agent", should_continue, {"tool_node": "tool_node", END: END})
        builder.add_edge("tool_node", "agent")
    else:
        builder.add_edge("agent", END)

{{ if (eq .input_use_lakebase "yes") }}
    checkpointer = get_checkpointer()
    return builder.compile(checkpointer=checkpointer)
{{ else }}
    return builder.compile()
{{ end }}


graph = build_graph()
