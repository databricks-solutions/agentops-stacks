import os
import logging

from langgraph.graph import START, END, StateGraph, MessagesState
from langgraph.prebuilt import ToolNode
from databricks_langchain import ChatDatabricks
from tools import get_tools
{{ if (eq .input_use_vector_search "yes") }}
from databricks_langchain import DatabricksVectorSearch
from langchain_core.messages import SystemMessage, HumanMessage
{{ end }}

logger = logging.getLogger(__name__)
LLM_ENDPOINT = os.environ.get("LLM_ENDPOINT", "databricks-claude-sonnet-4")

{{ if (eq .input_use_vector_search "yes") }}
# --- Vector Search retriever ---

def get_relevant_chunks(query: str, k: int = 5) -> list[str]:
    """Query the VS index and return chunk texts."""
    from databricks.sdk import WorkspaceClient
    w = WorkspaceClient()
    vs_index = f"{os.environ['CATALOG']}.{os.environ['SCHEMA']}.{{ .input_project_name }}_vs_index"
    retriever = DatabricksVectorSearch(
        index_name=vs_index,
        columns=["content", "doc_uri"],
        workspace_client=w,
    ).as_retriever(search_kwargs={"k": k})
    docs = retriever.invoke(query)
    return [doc.page_content for doc in docs]
{{ end }}

# --- Nodes ---

def agent_node(state: MessagesState) -> dict:
    """Call the LLM with tools bound."""
    tools = get_tools()
    llm = ChatDatabricks(endpoint=LLM_ENDPOINT)
    if tools:
        llm = llm.bind_tools(tools)
    response = llm.invoke(state["messages"])
    return {"messages": [response]}

{{ if (eq .input_use_vector_search "yes") }}
def retriever_node(state: MessagesState) -> dict:
    """Retrieve relevant chunks from Vector Search and prepend as context."""
    # Find the last human message for the retrieval query
    query = ""
    for msg in reversed(state["messages"]):
        if isinstance(msg, HumanMessage):
            query = msg.content
            break
    if not query:
        return {"messages": []}
    chunks = get_relevant_chunks(query)
    context = "\n\n".join(chunks)
    return {"messages": [SystemMessage(content=f"Relevant context:\n{context}")]}
{{ end }}

def should_continue(state: MessagesState) -> str:
    """Route to tool_node if the last message has tool calls, otherwise end."""
    last_message = state["messages"][-1]
    if hasattr(last_message, "tool_calls") and last_message.tool_calls:
        return "tool_node"
    return END

{{ if (and (eq .input_use_lakebase "yes") (or (eq .input_memory_type "short_term") (eq .input_memory_type "both"))) }}
# --- Lakebase (Autoscaling) short-term memory: conversation checkpointer ---

# Reused across requests. databricks-langchain's AsyncCheckpointSaver is a thin
# AsyncPostgresSaver subclass backed by a Lakebase connection pool that mints and
# rotates short-lived Lakebase OAuth credentials on each physical connection, so
# the saver is safe to keep open — no per-request reconnection is needed.
_checkpointer = None
_checkpointer_ready = False


async def get_async_checkpointer():
    """Return a process-wide AsyncCheckpointSaver bound to the Lakebase endpoint.

    Returns None (agent runs without short-term memory) if LAKEBASE_ENDPOINT is
    unset or the connection fails.
    """
    global _checkpointer, _checkpointer_ready

    endpoint = os.environ.get("LAKEBASE_ENDPOINT")
    if not endpoint:
        return None

    try:
        from databricks_langchain import AsyncCheckpointSaver

        if _checkpointer is None:
            _checkpointer = AsyncCheckpointSaver(autoscaling_endpoint=endpoint)
            # Open the underlying Lakebase pool (what `async with` does under the
            # hood) and keep it open for the process lifetime.
            await _checkpointer.__aenter__()
        if not _checkpointer_ready:
            await _checkpointer.setup()
            _checkpointer_ready = True
            logger.info(f"Lakebase checkpointer connected to {endpoint}")
        return _checkpointer
    except Exception as e:
        logger.warning(f"Failed to connect to Lakebase ({endpoint}): {e}. Running without short-term memory.")
        return None
{{ end }}
{{ if (and (eq .input_use_lakebase "yes") (or (eq .input_memory_type "long_term") (eq .input_memory_type "both"))) }}
# --- Lakebase (Autoscaling) long-term memory: per-user semantic store ---

# AsyncDatabricksStore persists durable, per-user facts and supports semantic
# search via a Databricks embedding endpoint. Exposed to the agent through the
# get_user_memory / save_user_memory / delete_user_memory tools (see tools.py),
# which read this store from the request config. Kept open across requests.
_store = None
_store_ready = False


async def get_async_store():
    """Return a process-wide AsyncDatabricksStore bound to the Lakebase endpoint.

    Returns None (agent runs without long-term memory) if LAKEBASE_ENDPOINT is
    unset or the connection fails.
    """
    global _store, _store_ready

    endpoint = os.environ.get("LAKEBASE_ENDPOINT")
    if not endpoint:
        return None

    try:
        from databricks_langchain import AsyncDatabricksStore

        embedding_endpoint = os.environ.get("DATABRICKS_EMBEDDING_ENDPOINT", "databricks-gte-large-en")
        if _store is None:
            _store = AsyncDatabricksStore(
                autoscaling_endpoint=endpoint,
                embedding_endpoint=embedding_endpoint,
                embedding_dims=1024,  # databricks-gte-large-en
            )
            await _store.__aenter__()
        if not _store_ready:
            await _store.setup()
            _store_ready = True
            logger.info(f"Lakebase long-term store connected to {endpoint}")
        return _store
    except Exception as e:
        logger.warning(f"Failed to connect to Lakebase store ({endpoint}): {e}. Running without long-term memory.")
        return None
{{ end }}

# --- Graph ---

def build_graph():
    tools = get_tools()
    builder = StateGraph(MessagesState)

{{ if (eq .input_use_vector_search "yes") }}
    builder.add_node("retriever", retriever_node)
{{ end }}
    builder.add_node("agent", agent_node)
    if tools:
        builder.add_node("tool_node", ToolNode(tools))

{{ if (eq .input_use_vector_search "yes") }}
    builder.add_edge(START, "retriever")
    builder.add_edge("retriever", "agent")
{{ else }}
    builder.add_edge(START, "agent")
{{ end }}

    if tools:
        builder.add_conditional_edges("agent", should_continue, {"tool_node": "tool_node", END: END})
        builder.add_edge("tool_node", "agent")
    else:
        builder.add_edge("agent", END)

    return builder


# Export builder for per-request compilation with checkpointer
graph_builder = build_graph()

# Compiled graph without checkpointer (used at startup, fallback)
graph = graph_builder.compile()
