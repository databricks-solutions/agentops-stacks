# Local development environment configuration for {{ .input_initial_agent_name }}
# Copy to .env and fill in values: cp .env.example .env

# Databricks authentication — use a CLI profile or set host + token
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-url>
# DATABRICKS_TOKEN=dapi...

# Unity Catalog location. In dev the bundle's schema is dev-prefixed
# (dev_<you>_<schema>); after the first `databricks bundle deploy -t dev`, copy
# both from `databricks bundle summary -t dev -o json`:
#   .resources.schemas.project_schema.catalog_name and .name
CATALOG=
SCHEMA=

# LLM endpoint (Foundation Model API)
LLM_ENDPOINT=databricks-claude-sonnet-4-5

{{ if (eq .input_use_lakebase "yes") }}
# Lakebase (Autoscaling) endpoint for agent memory.
# Prefilled with the auto-created read-write endpoint (`primary`) on the default
# `production` branch. Verify with:
#   databricks postgres list-endpoints projects/{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-memory/branches/production
LAKEBASE_ENDPOINT=projects/{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-memory/branches/production/endpoints/primary
{{ end }}{{ if (and (eq .input_use_lakebase "yes") (or (eq .input_memory_type "long_term") (eq .input_memory_type "both"))) }}# Embedding endpoint for long-term memory semantic search (default: databricks-gte-large-en, 1024 dims)
# DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
{{ end }}
# MLflow tracing: send traces to the Databricks workspace (not a local mlflow.db),
# into the dev bundle experiment: .resources.experiments.experiment.id in
# `databricks bundle summary -t dev -o json`.
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_ID=
