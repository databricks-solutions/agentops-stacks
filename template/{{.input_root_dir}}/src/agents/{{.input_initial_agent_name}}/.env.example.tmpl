# Local development environment configuration for {{ .input_initial_agent_name }}
# Copy to .env and fill in values: cp .env.example .env

# Databricks authentication — use a CLI profile or set host + token
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-url>
# DATABRICKS_TOKEN=dapi...

# Unity Catalog location
CATALOG=
SCHEMA=

# LLM endpoint (Foundation Model API)
LLM_ENDPOINT=databricks-claude-sonnet-4

{{ if (eq .input_use_lakebase "yes") }}
# Lakebase connection for conversation memory
LAKEBASE_INSTANCE=
LAKEBASE_HOST=
LAKEBASE_DB=default
{{ end }}
# MLflow experiment for tracing
MLFLOW_EXPERIMENT_ID=
