"""AgentServer for {{ .input_initial_agent_name }}.

Starts a FastAPI server that serves the agent via MLflow's AgentServer.
"""

import sys
from pathlib import Path

# Add agent directory to sys.path so local imports resolve
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from dotenv import load_dotenv
from mlflow.genai.agent_server import AgentServer

# Load env vars from agent-level .env for local development
load_dotenv(dotenv_path=Path(__file__).parents[1] / ".env", override=True)

# Import the agent to register @invoke/@stream handlers with the server
import agent  # noqa: F401

agent_server = AgentServer("{{ .input_initial_agent_name }}", enable_chat_proxy=True)

# Module-level app variable for uvicorn workers
app = agent_server.app  # noqa: F841


if __name__ == "__main__":
    agent_server.run(
        app_import_string="app.start_server:app"
    )
