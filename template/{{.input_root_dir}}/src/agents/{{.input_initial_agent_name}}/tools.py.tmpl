def get_tools() -> list:
    """Return the tools available to this agent."""
    tools = []
{{ if (eq .input_use_local_tools "yes") }}
    from example_tool import example_tool
    tools.append(example_tool)
{{ end }}
{{ if (eq .input_use_genie "yes") }}
    from genie_tool import query_genie
    tools.append(query_genie)
{{ end }}
{{ if (eq .input_use_uc_functions "yes") }}
    if UC_FUNCTION_NAMES:
        from databricks_langchain.uc_ai import UCFunctionToolkit
        toolkit = UCFunctionToolkit(function_names=UC_FUNCTION_NAMES)
        tools.extend(toolkit.get_tools())
{{ end }}
    return tools
