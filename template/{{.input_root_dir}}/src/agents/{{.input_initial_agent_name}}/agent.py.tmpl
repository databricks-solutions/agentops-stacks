import logging
import uuid
from typing import AsyncGenerator

import mlflow
from mlflow.genai.agent_server import invoke, stream
from mlflow.types.responses import (
    ResponsesAgentRequest,
    ResponsesAgentResponse,
    ResponsesAgentStreamEvent,
    to_chat_completions_input,
)

{{ if (eq .input_use_lakebase "yes") -}}
from graph import graph_builder{{ if (or (eq .input_memory_type "short_term") (eq .input_memory_type "both")) }}, get_async_checkpointer{{ end }}{{ if (or (eq .input_memory_type "long_term") (eq .input_memory_type "both")) }}, get_async_store{{ end }}
{{- else }}
from graph import graph
{{- end }}
from app.utils import (
    get_session_id,
{{ if (and (eq .input_use_lakebase "yes") (or (eq .input_memory_type "long_term") (eq .input_memory_type "both"))) }}    get_user_id,
{{ end }}    process_agent_astream_events,
)

logger = logging.getLogger(__name__)
mlflow.langchain.autolog()


@invoke()
async def invoke_handler(request: ResponsesAgentRequest) -> ResponsesAgentResponse:
    """Handle synchronous invocation requests."""
    outputs = [
        event.item
        async for event in stream_handler(request)
        if event.type == "response.output_item.done"
    ]
    return ResponsesAgentResponse(output=outputs)


@stream()
async def stream_handler(
    request: ResponsesAgentRequest,
) -> AsyncGenerator[ResponsesAgentStreamEvent, None]:
    """Handle streaming requests."""
    if not isinstance(request, ResponsesAgentRequest):
        request = ResponsesAgentRequest(**request)

    session_id = get_session_id(request)
    if session_id:
        mlflow.update_current_trace(metadata={"mlflow.trace.session": session_id})

    messages = {"messages": to_chat_completions_input([i.model_dump() for i in request.input])}

{{ if (eq .input_use_lakebase "yes") }}
    # Compile per-request, attaching whichever memory backends are configured.
    # Each backend degrades gracefully to None (agent still answers, no memory).
    configurable = {}
    compile_kwargs = {}
{{ if (or (eq .input_memory_type "short_term") (eq .input_memory_type "both")) }}
    # Short-term memory: conversation checkpointer keyed by thread_id.
    checkpointer = await get_async_checkpointer()
    if checkpointer:
        compile_kwargs["checkpointer"] = checkpointer
        configurable["thread_id"] = session_id or str(uuid.uuid4())
{{ end }}
{{ if (or (eq .input_memory_type "long_term") (eq .input_memory_type "both")) }}
    # Long-term memory: per-user store surfaced through the memory tools.
    store = await get_async_store()
    if store:
        compile_kwargs["store"] = store
        configurable["store"] = store
        configurable["user_id"] = get_user_id(request)
{{ end }}
    compiled = graph_builder.compile(**compile_kwargs)
    config = {"configurable": configurable} if configurable else {}
{{ else }}
    compiled = graph
    config = {}
{{ end }}

    async for event in process_agent_astream_events(
        compiled.astream(input=messages, config=config, stream_mode=["updates", "messages"])
    ):
        yield event
