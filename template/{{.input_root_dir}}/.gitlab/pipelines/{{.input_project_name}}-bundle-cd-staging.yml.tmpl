# Staging deploy for {{ .input_project_name }} — validates, deploys, runs eval gate if applied.
default:
  image: python:3.11-slim
  before_script:
    - apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
    - curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh

variables:
  {{ if (eq .input_cloud `azure`) -}}
  ARM_TENANT_ID: "${STAGING_AZURE_SP_TENANT_ID}"
  ARM_CLIENT_ID: "${STAGING_AZURE_SP_APPLICATION_ID}"
  ARM_CLIENT_SECRET: "${STAGING_AZURE_SP_CLIENT_SECRET}"
  {{- else -}}
  DATABRICKS_TOKEN: "${STAGING_WORKSPACE_TOKEN}"
  {{- end }}

stages:
  - deploy

deploy_staging:
  stage: deploy
  environment: staging
  script:
    - databricks bundle validate -t staging
    - databricks bundle deploy -t staging
    - |
      # `bundle deploy` doesn't ship code to the Apps or start them; `bundle run` does, for every App.
      for app in $(databricks bundle summary -t staging -o json | python3 -c 'import json, sys; print(" ".join(json.load(sys.stdin).get("resources", {}).get("apps", {})))'); do
        databricks bundle run "$app" -t staging
      done

eval_gate:
  stage: deploy
  needs: [deploy_staging]
  rules:
    - exists:
        - evaluation/thresholds.yml
  script:
    - pip install uv==0.12.23
    - uv sync --frozen
    - |
      if [ -f evaluation/gate.py ]; then
        uv run python evaluation/gate.py
      else
        echo "evaluation/thresholds.yml exists but evaluation/gate.py is missing." >&2
        exit 1
      fi
