# PR checks for {{ .input_project_name }} — unit tests, bundle validation, conditional eval gate.
default:
  image: python:3.11-slim
  before_script:
    - apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
    - curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh

variables:
  {{ if (eq .input_cloud `azure`) -}}
  ARM_TENANT_ID: "${STAGING_AZURE_SP_TENANT_ID}"
  ARM_CLIENT_ID: "${STAGING_AZURE_SP_APPLICATION_ID}"
  ARM_CLIENT_SECRET: "${STAGING_AZURE_SP_CLIENT_SECRET}"
  {{- else -}}
  DATABRICKS_CLIENT_ID: "${STAGING_SP_CLIENT_ID}"
  DATABRICKS_CLIENT_SECRET: "${STAGING_SP_CLIENT_SECRET}"
  {{- end }}
  # Run exactly what uv.lock pins: `uv run` must not re-resolve and rewrite the lock.
  UV_FROZEN: "1"

stages:
  - test

unit_tests:
  stage: test
  script:
    - pip install uv==0.12.23
    # Each agent has its own pyproject.toml; there's none at the project root.
    - cd src/agents/{{ .input_initial_agent_name }}
    - uv sync --frozen
    # Exit 5 from pytest means "no tests collected" — pass until the project adds tests.
    - uv run pytest ../../../tests/ --junitxml="$CI_PROJECT_DIR/test-unit.xml" || [ $? -eq 5 ]
  artifacts:
    when: always
    reports:
      junit: test-unit.xml

validate_bundle:
  stage: test
  script:
    - databricks bundle validate -t staging

eval_gate:
  stage: test
  needs: [validate_bundle]
  rules:
    - exists:
        - "src/agents/*/eval/gates.yml"
  script:
    - pip install uv==0.12.23
    - |
      # evaluate_agent.py scores the target's UC eval table with Databricks-hosted judges and
      # exits non-zero when a gate fails. Host, catalog, schema and experiment come from the bundle.
      eval "$(databricks bundle summary -t staging -o json | python3 -c 'import json, sys; d = json.load(sys.stdin); s = d["resources"]["schemas"]["project_schema"]; e = d["resources"].get("experiments", {}).get("experiment", {}).get("id"); print("export DATABRICKS_HOST=%s CATALOG=%s SCHEMA=%s MLFLOW_TRACKING_URI=databricks" % (d["workspace"]["host"], s["catalog_name"], s["name"])); e and print("export MLFLOW_EXPERIMENT_ID=%s" % e)')"
      for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
        agent_dir=$(dirname "$(dirname "$gates_file")")
        echo "Running eval gate for $agent_dir"
        (cd "$agent_dir" && uv sync --frozen && uv run python eval/evaluate_agent.py) || exit 1
      done
