# Azure DevOps pipeline for {{ .input_project_name }}.
#   - BundleCI runs on PRs against main (unit tests + bundle validate + conditional eval gate).
#   - StagingBundleCD runs on push to main (deploy to staging + post-deploy eval gate).
#   - ProdBundleCD runs on tag matching v* (deploy to prod + eval gate + governance check).

trigger:
  branches:
    include:
      - main
  tags:
    include:
      - v*

variables:
  - name: workingDirectory
    value: .
  # Run exactly what uv.lock pins: `uv run` must not re-resolve and rewrite the lock.
  - name: UV_FROZEN
    value: "1"
  - group: {{ .input_root_dir }}

stages:
  - stage: BundleCI
    displayName: 'PR checks for {{ .input_project_name }}'
    condition: |
      and(
        eq(variables['Build.Reason'], 'PullRequest'),
        eq(variables['System.PullRequest.TargetBranch'], 'refs/heads/main')
      )
    jobs:
      - job: UnitTests
        displayName: 'Unit tests'
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
            clean: true
          - script: |
              curl -LsSf https://astral.sh/uv/0.12.23/install.sh | sh
              export PATH="$HOME/.local/bin:$PATH"
              # Each agent has its own pyproject.toml; there's none at the project root.
              cd src/agents/{{ .input_initial_agent_name }}
              uv sync --frozen
              # Exit 5 from pytest means "no tests collected" — pass until the project adds tests.
              uv run pytest ../../../tests/ --junitxml="$(System.DefaultWorkingDirectory)/test-unit.xml" || [ $? -eq 5 ]
            displayName: 'Run unit tests with pytest'
          - task: PublishTestResults@2
            condition: succeededOrFailed()
            inputs:
              testResultsFiles: 'test-unit.xml'

      - job: ValidateBundle
        displayName: 'Validate bundle for staging'
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
            clean: true
          - script: |
              curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh
            displayName: 'Install Databricks CLI'
          - script: |
              databricks bundle validate -t staging
            workingDirectory: $(workingDirectory)
            displayName: 'Validate bundle for staging'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(STAGING_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(STAGING_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(STAGING_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(STAGING_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(STAGING_SP_CLIENT_SECRET)
              {{- end }}

      - job: EvalGate
        displayName: 'Eval gate (conditional)'
        dependsOn: ValidateBundle
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
            clean: true
          - script: |
              curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh
            displayName: 'Install Databricks CLI'
          - script: |
              curl -LsSf https://astral.sh/uv/0.12.23/install.sh | sh
              export PATH="$HOME/.local/bin:$PATH"
              if ! ls src/agents/*/eval/gates.yml >/dev/null 2>&1; then
                echo "No eval gate configured (no src/agents/*/eval/gates.yml) — skipping."
                exit 0
              fi
              # evaluate_agent.py scores the target's UC eval table with Databricks-hosted judges and
              # exits non-zero when a gate fails. Host, catalog, schema and experiment come from the bundle.
              summary=$(databricks bundle summary -t staging -o json)
              export DATABRICKS_HOST=$(jq -r '.workspace.host' <<<"$summary")
              export CATALOG=$(jq -r '.resources.schemas.project_schema.catalog_name' <<<"$summary")
              export SCHEMA=$(jq -r '.resources.schemas.project_schema.name' <<<"$summary")
              export MLFLOW_TRACKING_URI=databricks
              experiment_id=$(jq -r '.resources.experiments.experiment.id // empty' <<<"$summary")
              if [ -n "$experiment_id" ]; then export MLFLOW_EXPERIMENT_ID="$experiment_id"; fi
              for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
                agent_dir=$(dirname "$(dirname "$gates_file")")
                echo "Running eval gate for $agent_dir"
                (cd "$agent_dir" && uv sync --frozen && uv run python eval/evaluate_agent.py) || exit 1
              done
            displayName: 'Run eval gate (conditional)'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(STAGING_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(STAGING_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(STAGING_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(STAGING_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(STAGING_SP_CLIENT_SECRET)
              {{- end }}

  - stage: StagingBundleCD
    displayName: 'Staging deploy for {{ .input_project_name }}'
    condition: |
      and(
        eq(variables['Build.SourceBranch'], 'refs/heads/main'),
        not(eq(variables['Build.Reason'], 'PullRequest'))
      )
    jobs:
      - job: DeployStaging
        displayName: 'Deploy bundle to staging'
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
            clean: true
          - script: |
              curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh
            displayName: 'Install Databricks CLI'
          - script: |
              databricks bundle validate -t staging
              databricks bundle deploy -t staging
              # `bundle deploy` doesn't ship code to the Apps or start them; `bundle run` does, for every App.
              for app in $(databricks bundle summary -t staging -o json | python3 -c 'import json, sys; print(" ".join(json.load(sys.stdin).get("resources", {}).get("apps", {})))'); do
                databricks bundle run "$app" -t staging || exit 1
              done
            workingDirectory: $(workingDirectory)
            displayName: 'Validate and deploy bundle to staging'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(STAGING_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(STAGING_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(STAGING_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(STAGING_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(STAGING_SP_CLIENT_SECRET)
              {{- end }}
          - script: |
              curl -LsSf https://astral.sh/uv/0.12.23/install.sh | sh
              export PATH="$HOME/.local/bin:$PATH"
              if ! ls src/agents/*/eval/gates.yml >/dev/null 2>&1; then
                echo "No eval gate configured (no src/agents/*/eval/gates.yml) — skipping."
                exit 0
              fi
              # evaluate_agent.py scores the target's UC eval table with Databricks-hosted judges and
              # exits non-zero when a gate fails. Host, catalog, schema and experiment come from the bundle.
              summary=$(databricks bundle summary -t staging -o json)
              export DATABRICKS_HOST=$(jq -r '.workspace.host' <<<"$summary")
              export CATALOG=$(jq -r '.resources.schemas.project_schema.catalog_name' <<<"$summary")
              export SCHEMA=$(jq -r '.resources.schemas.project_schema.name' <<<"$summary")
              export MLFLOW_TRACKING_URI=databricks
              experiment_id=$(jq -r '.resources.experiments.experiment.id // empty' <<<"$summary")
              if [ -n "$experiment_id" ]; then export MLFLOW_EXPERIMENT_ID="$experiment_id"; fi
              for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
                agent_dir=$(dirname "$(dirname "$gates_file")")
                echo "Running eval gate for $agent_dir"
                (cd "$agent_dir" && uv sync --frozen && uv run python eval/evaluate_agent.py) || exit 1
              done
            displayName: 'Run eval gate (conditional)'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(STAGING_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(STAGING_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(STAGING_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(STAGING_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(STAGING_SP_CLIENT_SECRET)
              {{- end }}

  - stage: ProdBundleCD
    displayName: 'Prod deploy for {{ .input_project_name }}'
    condition: startsWith(variables['Build.SourceBranch'], 'refs/tags/v')
    jobs:
      - job: DeployProd
        displayName: 'Deploy bundle to prod'
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
            clean: true
          - script: |
              curl -fsSL https://raw.githubusercontent.com/databricks/setup-cli/{{template `cli_version` .}}/install.sh | sh
            displayName: 'Install Databricks CLI'
          - script: |
              databricks bundle validate -t prod
              databricks bundle deploy -t prod
              # `bundle deploy` doesn't ship code to the Apps or start them; `bundle run` does, for every App.
              for app in $(databricks bundle summary -t prod -o json | python3 -c 'import json, sys; print(" ".join(json.load(sys.stdin).get("resources", {}).get("apps", {})))'); do
                databricks bundle run "$app" -t prod || exit 1
              done
            workingDirectory: $(workingDirectory)
            displayName: 'Validate and deploy bundle to prod'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(PROD_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(PROD_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(PROD_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(PROD_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(PROD_SP_CLIENT_SECRET)
              {{- end }}
          - script: |
              curl -LsSf https://astral.sh/uv/0.12.23/install.sh | sh
              export PATH="$HOME/.local/bin:$PATH"
              if ! ls src/agents/*/eval/gates.yml >/dev/null 2>&1; then
                echo "No eval gate configured (no src/agents/*/eval/gates.yml) — skipping."
                exit 0
              fi
              # evaluate_agent.py scores the target's UC eval table with Databricks-hosted judges and
              # exits non-zero when a gate fails. Host, catalog, schema and experiment come from the bundle.
              summary=$(databricks bundle summary -t prod -o json)
              export DATABRICKS_HOST=$(jq -r '.workspace.host' <<<"$summary")
              export CATALOG=$(jq -r '.resources.schemas.project_schema.catalog_name' <<<"$summary")
              export SCHEMA=$(jq -r '.resources.schemas.project_schema.name' <<<"$summary")
              export MLFLOW_TRACKING_URI=databricks
              experiment_id=$(jq -r '.resources.experiments.experiment.id // empty' <<<"$summary")
              if [ -n "$experiment_id" ]; then export MLFLOW_EXPERIMENT_ID="$experiment_id"; fi
              for gates_file in $(find src/agents -name "gates.yml" -path "*/eval/gates.yml"); do
                agent_dir=$(dirname "$(dirname "$gates_file")")
                echo "Running eval gate for $agent_dir"
                (cd "$agent_dir" && uv sync --frozen && uv run python eval/evaluate_agent.py) || exit 1
              done
            displayName: 'Run eval gate (conditional)'
            env:
              {{ if (eq .input_cloud `azure`) -}}
              ARM_TENANT_ID: $(PROD_AZURE_SP_TENANT_ID)
              ARM_CLIENT_ID: $(PROD_AZURE_SP_APPLICATION_ID)
              ARM_CLIENT_SECRET: $(PROD_AZURE_SP_CLIENT_SECRET)
              {{- else -}}
              DATABRICKS_CLIENT_ID: $(PROD_SP_CLIENT_ID)
              DATABRICKS_CLIENT_SECRET: $(PROD_SP_CLIENT_SECRET)
              {{- end }}
          - script: |
              if [ -f governance/posture.md ]; then
                if [ ! -s governance/posture.md ]; then
                  echo "##vso[task.logissue type=error]governance/posture.md exists but is empty."
                  exit 1
                fi
              else
                echo "No governance posture documented — skipping check."
              fi
            displayName: 'Verify governance posture (conditional)'
