bundle:
  name: {{ .input_project_name }}
  engine: direct

variables:
  catalog:
    description: Unity Catalog for project resources (overridden per target)
  schema:
    description: Schema within the catalog for resources, traces, and artifacts
    default: {{ .input_project_name }}
{{ if (eq .input_enable_cost_tags "yes") }}  usage_policy_id:
    # Serverless usage policy whose custom tags (project, environment) are applied
    # to serverless usage: Apps, Vector Search, pipelines, Lakebase. A workspace
    # admin creates it (see docs/usage-tracking.md). Override per target to split
    # usage by environment.
    description: Serverless usage policy ID for usage tracking and cost attribution
    default: "{{ .input_usage_policy_id }}"
{{ end }}
include:
  - ./resources/experiment.yml
  - ./resources/schemas.yml
  - ./resources/volumes.yml
{{ if (eq .input_use_vector_search "yes") }}  - ./resources/vector_search.yml
{{ end }}
{{ if (and (eq .input_use_vector_search "yes") (eq .input_has_chunked_table "no")) }}  - ./resources/data_pipeline.yml
{{ end }}
{{ if (eq .input_use_uc_functions "yes") }}  - ./resources/uc_function_registration.yml
{{ end }}
{{ if (eq .input_use_lakebase "yes") }}  - ./resources/lakebase.yml
{{ end }}

resources:
  apps:
    {{ .input_initial_agent_name }}:
      name: "{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-{{ (regexp "_").ReplaceAllString .input_initial_agent_name "-" }}"
      description: "{{ .input_initial_agent_name }} agent — {{ .input_project_name }}"
      source_code_path: ./src/agents/{{ .input_initial_agent_name }}
      config:
        # --frozen --no-dev: run the deps the App build installed from uv.lock,
        # without re-resolving or pulling dev-only packages at startup.
        command: ["uv", "run", "--frozen", "--no-dev", "python", "app/start_server.py"]
        # The App's env lives here (not in a source app.yaml) so per-target values
        # are resolved at deploy time. Values set here override any app.yaml.
        env:
          - name: CATALOG
            value: ${var.catalog}
          - name: SCHEMA
            # The bundle's schema (dev-prefixed in development mode).
            value: ${resources.schemas.project_schema.name}
          - name: LLM_ENDPOINT
            value: "databricks-claude-sonnet-4-5"
          - name: MLFLOW_TRACKING_URI
            value: "databricks"
          - name: MLFLOW_EXPERIMENT_ID
            # Traces go to the experiment attached below.
            value_from: "experiment"
{{ if (eq .input_use_lakebase "yes") }}          - name: LAKEBASE_ENDPOINT
            # Prefilled with the derivable path to the auto-created read-write endpoint.
            # `bundle deploy` creates the memory project with a default `production` branch
            # and a primary read-write endpoint named `primary` — every path segment below
            # is fixed by the project slug, so this needs no editing in the common case.
            # If you renamed the branch or added a custom endpoint, verify the exact path with:
            #   databricks postgres list-endpoints projects/{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-memory/branches/production
            value: "projects/{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-memory/branches/production/endpoints/primary"
{{ end }}{{ if (and (eq .input_use_lakebase "yes") (or (eq .input_memory_type "long_term") (eq .input_memory_type "both"))) }}          - name: DATABRICKS_EMBEDDING_ENDPOINT
            value: "databricks-gte-large-en" # Embedding endpoint for long-term memory semantic search (1024 dims)
{{ end }}{{ if (eq .input_enable_cost_tags "yes") }}      {{ template `usage_policy_line` . }}
{{ end }}      resources:
        - name: "experiment"
          experiment:
            experiment_id: ${resources.experiments.experiment.id}
            permission: "CAN_MANAGE"
        - name: "artifacts"
          # Lets the App's service principal write traces and artifacts to the
          # experiment's UC volume; the platform grants USE CATALOG / USE SCHEMA
          # on the parents. The deploying identity needs MANAGE on the catalog
          # (see docs/setup.md, section 2b).
          uc_securable:
            securable_full_name: ${var.catalog}.${resources.schemas.project_schema.name}.${resources.volumes.artifacts.name}
            securable_type: "VOLUME"
            permission: "WRITE_VOLUME"
{{ if (eq .input_use_lakebase "yes") }}        - name: "memory"
          postgres:
            branch: ${resources.postgres_projects.memory.id}/branches/production
            # The database *resource id* is hyphenated (databricks-postgres); the
            # Postgres database name it maps to is databricks_postgres.
            database: ${resources.postgres_projects.memory.id}/branches/production/databases/databricks-postgres
            permission: "CAN_CONNECT_AND_CREATE"
{{ end }}

targets:
  dev:
    default: true
    mode: development
    workspace:
      host: # TODO: set dev workspace URL
    variables:
      catalog: {{ .input_project_name }}_dev
{{ if (eq .input_enable_cost_tags "yes") }}      # Use a per-environment usage policy to split serverless usage by environment:
      # usage_policy_id: <dev-usage-policy-id>
{{ end }}{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Scale the memory endpoint to zero after 5 min idle to save cost in dev.
          default_endpoint_settings:
            suspend_timeout_duration: 300s
{{ end }}
  staging:
    mode: production
    workspace:
      host: # TODO: set staging workspace URL
    variables:
      catalog: {{ .input_project_name }}_staging
{{ if (eq .input_enable_cost_tags "yes") }}      # Use a per-environment usage policy to split serverless usage by environment:
      # usage_policy_id: <staging-usage-policy-id>
{{ end }}    run_as:
      user_name: ${workspace.current_user.userName}
{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Keep the memory endpoint always-on in staging to avoid cold-start latency.
          default_endpoint_settings:
            no_suspension: true
{{ end }}
  prod:
    mode: production
    workspace:
      host: # TODO: set prod workspace URL
    variables:
      catalog: {{ .input_project_name }}_prod
{{ if (eq .input_enable_cost_tags "yes") }}      # Use a per-environment usage policy to split serverless usage by environment:
      # usage_policy_id: <prod-usage-policy-id>
{{ end }}    run_as:
      user_name: ${workspace.current_user.userName}
{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Keep the memory endpoint always-on in prod to avoid cold-start latency.
          default_endpoint_settings:
            no_suspension: true
{{ end }}
