bundle:
  name: {{ .input_project_name }}
  engine: direct

variables:
  catalog:
    description: Unity Catalog for project resources (overridden per target)
  schema:
    description: Schema within the catalog for resources, traces, and artifacts
    default: {{ .input_project_name }}


include:
  - ./resources/experiment.yml
  - ./resources/schemas.yml
  - ./resources/volumes.yml
{{ if (eq .input_use_vector_search "yes") }}  - ./resources/vector_search.yml
{{ end }}
{{ if (and (eq .input_use_vector_search "yes") (eq .input_has_chunked_table "no")) }}  - ./resources/data_pipeline.yml
{{ end }}
{{ if (eq .input_use_uc_functions "yes") }}  - ./resources/uc_function_registration.yml
{{ end }}
{{ if (eq .input_use_lakebase "yes") }}  - ./resources/lakebase.yml
{{ end }}

resources:
  apps:
    {{ .input_initial_agent_name }}:
      name: "{{ (regexp "_").ReplaceAllString .input_project_name "-" }}-{{ (regexp "_").ReplaceAllString .input_initial_agent_name "-" }}"
      description: "{{ .input_initial_agent_name }} agent — {{ .input_project_name }}"
      source_code_path: ./src/agents/{{ .input_initial_agent_name }}
      config:
        command: ["uv", "run", "python", "app/start_server.py"]
      resources:
        - name: "experiment"
          experiment:
            experiment_id: ${resources.experiments.experiment.id}
            permission: "CAN_MANAGE"
{{ if (eq .input_use_lakebase "yes") }}        - name: "memory"
          postgres:
            branch: ${resources.postgres_projects.memory.id}/branches/production
            # The database *resource id* is hyphenated (databricks-postgres); the
            # Postgres database name it maps to is databricks_postgres.
            database: ${resources.postgres_projects.memory.id}/branches/production/databases/databricks-postgres
            permission: "CAN_CONNECT_AND_CREATE"
{{ end }}

sync:
  include:
    - src/agents/**

targets:
  dev:
    default: true
    mode: development
    workspace:
      host: # TODO: set dev workspace URL
    variables:
      catalog: {{ .input_project_name }}_dev
{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Scale the memory endpoint to zero after 5 min idle to save cost in dev.
          default_endpoint_settings:
            suspend_timeout_duration: 300s
{{ end }}
  staging:
    mode: production
    workspace:
      host: # TODO: set staging workspace URL
    variables:
      catalog: {{ .input_project_name }}_staging
    run_as:
      user_name: ${workspace.current_user.userName}
{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Keep the memory endpoint always-on in staging to avoid cold-start latency.
          default_endpoint_settings:
            no_suspension: true
{{ end }}
  prod:
    mode: production
    workspace:
      host: # TODO: set prod workspace URL
    variables:
      catalog: {{ .input_project_name }}_prod
    run_as:
      user_name: ${workspace.current_user.userName}
{{ if (eq .input_use_lakebase "yes") }}    resources:
      postgres_projects:
        memory:
          # Keep the memory endpoint always-on in prod to avoid cold-start latency.
          default_endpoint_settings:
            no_suspension: true
{{ end }}
