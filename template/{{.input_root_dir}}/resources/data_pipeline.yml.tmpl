resources:
  pipelines:
    data_pipeline:
      name: ${bundle.target}-{{ .input_project_name }}-data-pipeline
      catalog: ${var.catalog}
      target: ${resources.schemas.project_schema.name}
      libraries:
        - notebook:
            path: ../src/components/retriever/data_pipeline.py
      configuration:
        catalog: ${var.catalog}
        schema: ${resources.schemas.project_schema.name}
      channel: PREVIEW
      serverless: true
{{ if (eq .input_enable_cost_tags "yes") }}      # Usage tracking: serverless pipelines take billing tags from the usage policy.
      # A job-triggered pipeline doesn't inherit the job's policy, and in development
      # mode policy tag changes take up to 24 hours to apply (see docs/usage-tracking.md).
      {{ template `usage_policy_line` . }}
      tags:
        project: {{ .input_project_name }}
        environment: ${bundle.target}
{{ end }}