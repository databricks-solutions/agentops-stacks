variables:
  embedding_model_endpoint:
    description: Foundation Model API endpoint for computing embeddings
    default: databricks-gte-large-en

resources:
  vector_search_endpoints:
    vs_endpoint:
      name: {{ .input_project_name }}_vs_endpoint
      endpoint_type: STANDARD
{{ if (eq .input_enable_cost_tags "yes") }}      # Usage tracking: VS endpoints take tags only via the serverless usage policy.
      # This endpoint name is the same in every target, so targets sharing a
      # workspace share one endpoint and the last deploy's policy wins.
      {{ template `usage_policy_line` . }}
{{ end }}
  vector_search_indexes:
    vs_index:
      name: ${var.catalog}.${resources.schemas.project_schema.name}.{{ .input_project_name }}_vs_index
      endpoint_name: {{ .input_project_name }}_vs_endpoint
      primary_key: chunk_id
      index_type: DELTA_SYNC
      delta_sync_index_spec:
        # The pipeline writes chunks to the bundle's schema; a pre-existing table lives in yours.
        source_table: ${var.catalog}.{{ if (eq .input_has_chunked_table "yes") }}${var.schema}{{ else }}${resources.schemas.project_schema.name}{{ end }}.{{ .input_project_name }}_chunked_docs
        embedding_source_columns:
          - name: content
            embedding_model_endpoint_name: ${var.embedding_model_endpoint}
        pipeline_type: TRIGGERED
        columns_to_sync:
          - chunk_id
          - content
          - doc_uri
