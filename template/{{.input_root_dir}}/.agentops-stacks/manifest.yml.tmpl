# AgentOps Stacks plugin recognition marker.
contract_version: 5
created_by: cli
project_name: {{ .input_project_name }}
cicd_platform: {{ .input_cicd_platform }}
cloud: {{ .input_cloud }}

# Agent architecture
framework: langgraph
eval_dataset_source: {{ .input_eval_dataset_source }}

# Shared components enabled
components:
  vector_search: {{ .input_use_vector_search }}
  lakebase: {{ .input_use_lakebase }}
{{ if (eq .input_use_lakebase "yes") }}  memory_type: {{ .input_memory_type }}
{{ end }}  uc_functions: {{ .input_use_uc_functions }}

# Registered agents (add new agents here or via /add-agent skill)
agents:
  - name: {{ .input_initial_agent_name }}

# Supervisor agent (added via /add-supervisor once you have >1 agent).
# Routes user queries across the agents above. Two patterns are supported —
# see docs/supervisor-patterns.md. None is configured until you add one.
# supervisor:
#   type: custom | supervisor_api
#   name: <supervisor_agent_name>
#   routes: [<agent_a>, <agent_b>]
