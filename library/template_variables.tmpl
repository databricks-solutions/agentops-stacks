# define template variables

# databricks/setup-cli pinned to a commit SHA (supply-chain hardening).
# SHA below is the immutable commit for tag v1.26.0. To bump: resolve the new
# tag to its commit SHA (`gh api repos/databricks/setup-cli/git/refs/tags/<tag>`)
# and replace both values here.
{{ define `cli_version` -}}
    2da6132749245fbffb3c10d57cec219de3669967
{{- end }}
{{ define `cli_version_tag` -}}
    v1.26.0
{{- end }}

# Serverless usage-policy attribution line for resources that support
# `budget_policy_id` (the API field name for serverless usage policies). Rendered
# live when a policy ID was given at init, otherwise as a commented TODO so an
# empty ID never reaches the API.
{{ define `usage_policy_line` -}}
    {{ if .input_usage_policy_id -}}
        budget_policy_id: ${var.usage_policy_id}
    {{- else -}}
        # budget_policy_id: ${var.usage_policy_id}  # TODO: wire with scripts/enable_usage_policy.py — see docs/usage-tracking.md
    {{- end }}
{{- end }}
